    },
    "closes": {
      "type": "array",
      "items": { "type": "number" }
    },
    "opens": {
      "type": "array",
      "items": { "type": "number" }
    },
    "highs": {
      "type": "array",
      "items": { "type": "number" }
    },
    "lows": {
      "type": "array",
      "items": { "type": "number" }
    },
    "volumes": {
      "type": "array",
      "items": { "type": "number" }
    },
    "iv_series": {
      "type": "array",
      "items": { "type": "number" }
    },
    "rv_series": {
      "type": "array",
      "items": { "type": "number" }
    }
  }
}
